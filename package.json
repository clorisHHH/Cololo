{
  "name": "cololo-image-to-prompt",
  "version": "0.1.0",
  "description": "COLOLO Image to Prompt desktop app",
  "main": "main.js",
  "scripts": {
    "dev": "electron .",
    "dist": "electron-builder --mac",
    "dist:win": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.cololo.imageprompt",
    "productName": "COLOLO",
    "files": [
          "index.html",
          "pet.html",
      "styles.css",
      "app.js",
      "bubble-preview.js",
      "copy_2_line.svg",
          "assets/**/*",
          "build/icon.icns",
          "main.js",
      "preload.js"
    ],
      "mac": {
        "category": "public.app-category.graphics-design",
        "target": ["dmg", "zip"],
        "icon": "build/icon.icns"
      },
      "win": {
        "target": ["nsis"],
        "icon": "assets/cololo-logo.png"
      },
      "nsis": {
        "artifactName": "${productName} Setup ${version}-${arch}.${ext}",
        "oneClick": false,
        "allowToChangeInstallationDirectory": true,
        "createDesktopShortcut": true,
        "createStartMenuShortcut": true,
        "shortcutName": "COLOLO"
      },
      "extraResources": [
        "build/icon.icns"
      ]
  },
  "devDependencies": {
    "electron": "^38.1.0",
    "electron-builder": "^26.0.12"
  }
}
